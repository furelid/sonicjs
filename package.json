{
  "name": "sonicjs",
  "version": "2.18.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "packages/*",
    "www",
    "my-sonicjs-app"
  ],
  "scripts": {
    "predev": "test -d node_modules/@sonicjs-cms || pnpm install",
    "dev": "pnpm run dev --workspace=my-sonicjs-app",
    "dev:www": "pnpm run dev --workspace=www",
    "build": "pnpm run build:core && pnpm run build --workspace=my-sonicjs-app",
    "build:www": "pnpm run build --workspace=www",
    "plugins:generate": "node packages/scripts/generate-plugin-registry.mjs",
    "build:core": "pnpm run plugins:generate && pnpm run build --workspace=@sonicjs-cms/core",
    "deploy": "pnpm run deploy --workspace=my-sonicjs-app",
    "deploy:www": "pnpm run deploy --workspace=www",
    "test": "pnpm run test --workspace=@sonicjs-cms/core",
    "test:cov": "pnpm run test:cov --workspace=@sonicjs-cms/core",
    "test:watch": "pnpm run test:watch --workspace=@sonicjs-cms/core",
    "e2e": "playwright test --config=tests/playwright.config.ts",
    "e2e:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "e2e:smoke": "playwright test --config=tests/playwright.smoke.config.ts",
    "e2e:smoke:ui": "playwright test --config=tests/playwright.smoke.config.ts --ui",
    "prepare": "husky",
    "type-check": "pnpm run type-check --workspace=@sonicjs-cms/core",
    "lint": "pnpm run type-check",
    "version:patch": "pnpm version patch --workspace=@sonicjs-cms/core --no-git-tag-version && node scripts/sync-versions.js",
    "version:minor": "pnpm version minor --workspace=@sonicjs-cms/core --no-git-tag-version && node scripts/sync-versions.js",
    "version:major": "pnpm version major --workspace=@sonicjs-cms/core --no-git-tag-version && node scripts/sync-versions.js",
    "publish:core": "pnpm run build:core && pnpm publish --workspace=@sonicjs-cms/core",
    "publish:create-app": "pnpm publish --workspace=create-sonicjs",
    "publish:all": "pnpm run publish:core && pnpm run publish:create-app",
    "release:patch": "pnpm run version:patch && pnpm run publish:all && pnpm run release:announce",
    "release:minor": "pnpm run version:minor && pnpm run publish:all && pnpm run release:announce",
    "release:major": "pnpm run version:major && pnpm run publish:all && pnpm run release:announce",
    "release:draft": "node scripts/release/generate-draft.js",
    "release:announce": "node scripts/release/index.js",
    "release:announce:dry": "node scripts/release/index.js --dry-run",
    "notify:discord": "node scripts/notify-discord.js",
    "social:discord": "node scripts/social/post-discord.js",
    "social:twitter": "node scripts/social/post-twitter.js",
    "social:post": "node scripts/social/post-both.js",
    "social:promote-blog": "node scripts/social/promote-blog.js",
    "db:reset": "pnpm run setup:db --workspace=my-sonicjs-app",
    "workspace": "pnpm install && pnpm run db:reset",
    "kill": "pkill workerd && pnpm run dev --workspace=my-sonicjs-app"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@hono/zod-openapi": "^0.19.8",
    "@hono/zod-validator": "^0.7.0",
    "@libsql/client": "^0.15.9",
    "@sonicjs-cms/core": "^2.0.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.12",
    "marked": "^16.4.1",
    "motion": "^12.23.22",
    "semver": "^7.7.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^24.9.2",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "^4.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.53.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5",
    "wrangler": "^4.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  }
}